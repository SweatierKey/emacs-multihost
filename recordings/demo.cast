[5.0534, "o", "\u001b[34d\u001b[?25l\u001b[97m\u001b[40morg-icalendar-export-agenda-files         \u001b[39;49m\u001b[38;5;116m\u001b[40mExport all agenda files to iCalendar files.                 \u001b[39;49m\u001b[97m\u001b[40m                 \u001b[39;49m\u001b[23;1H\u001b[97m\u001b[48;5;239m-UUU:---  F1  \u001b[39;49m\u001b[1m\u001b[97m\u001b[48;5;239mstart.org   \u001b[0m\u001b[39;49m\u001b[97m\u001b[48;5;239m   All   L1     (Org) ------------------------------------------------------------------------\u001b[39;49m\r\n\u001b[38;5;79m\u001b[40m1/5233 M-x \u001b[39;49m\u001b[97m\u001b[40m                                                                                                             \u001b[39;49m\r\n\u001b[1m\u001b[97m\u001b[48;5;24meval-print-last-sexp                      \u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;116m\u001b[48;5;24mEvaluate sexp before point; print value into current buffer.\u001b[0m\u001b[39;49m\u001b[1m\u001b[97m\u001b[48;5;24m                  \u001b[0m\u001b[39;49m\r\n\u001b[97m\u001b[40mtab-switcher-unmark                       \u001b[39;49m\u001b[38;5;116m\u001b[40mCancel operations on window configuration on this line and …\u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mcalendar-scroll-left-three-months         \u001b[39;49m\u001b[38;5;116m\u001b[40mScroll the displayed calendar window left by 3*ARG months.  \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mkill-comment                              \u001b[39;49m\u001b[38;5;116m\u001b[40mKill the first comment on this line, if any.                \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mstudlify-buffer                           \u001b[39;49m\u001b[38;5;116m\u001b[40mStudlify-case the current buffer.                           \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mpixel-scroll-precision-mode               \u001b[39;49m\u001b[38;5;116m\u001b[40mToggle pixel scrolling.                                     \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mgnus-summary-insert-new-articles          \u001b[39;49m\u001b[38;5;116m\u001b[40mInsert all new articles in this group.                      \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mfortune-add-fortune                       \u001b[39;49m\u001b[38;5;116m\u001b[40mAdd STRING to a fortune file FILE.                          \u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[97m\u001b[40mtear-off-window \u001b[39;49m\u001b[1m\u001b[38;5;39m\u001b[40m(C-x w ^ f)\u001b[0m\u001b[39;49m\u001b[97m\u001b[40m               \u001b[39;49m\u001b[38;5;116m\u001b[40mDelete the selected window, and create a new frame displayi…\u001b[39;49m\u001b[97m\u001b[40m                  \u001b[39;49m\r\n\u001b[24;12H\u001b[?12l\u001b[?25h\u001b[?12;25h"]

[34.4939, "i", "\u0003'"]
[34.4954, "o", "\u001b[H\u001b[?25l\u001b[38;5;246m\u001b[40m#+title:\u001b[39;49m\u001b[97m\u001b[40m \u001b[39;49m\u001b[1m\u001b[38;5;79m\u001b[40mOperations runbook · isolated SSH lab \u001b[0m\u001b[39;49m\u001b[97m\u001b[40m                                                                         \u001b[39;49m\r\n\u001b[38;5;246m\u001b[40m#+startup: showall\u001b[39;49m\r\n\u001b[97m\u001b[40m         \u001b[39;49m\r\n\u001b[1m\u001b[97m\u001b[40m* Serial health check\u001b[0m\u001b[39;49m\u001b[97m\u001b[40m     \u001b[39;49m\r\n\u001b[97m\u001b[40mRun db-01 first; wait for completion before starting web-01.                                                            \u001b[39;49m\r\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[38;5;246m\u001b[48;5;234m#+begin_src sh :hosts db-01 web-01 :concurrency 1 :renderer combined :results output :timeout 20                        \u001b[39;49m\r\n\u001b[97m\u001b[48;5;234mcat ops-                                                                                                                \u001b[39;49m\r\n\u001b[97m\u001b[48;5;234msleep 0.5                                                                                                               \u001b[39;49m\r\n\u001b[38;5;212m\u001b[48;5;234mprintf\u001b[39;49m\u001b[97m\u001b[48;5;234m \u001b[39;49m\u001b[38;5;111m\u001b[48;5;234m'check completed\\n'\u001b[39;49m\u001b[97m\u001b[48;5;234m                                                                                              \u001b[39;49m\r\n"]

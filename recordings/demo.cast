[2.0451, "o", "\u001b[34d\u001b[?25lFor information about GNU Emacs and the GNU system, type \u001b[38;5;18m\u001b[48;5;255mC-h C-a\u001b[39;49m.\u001b[H\n\u001b[?12l\u001b[?25h\u001b[?12;25h"]
[3.4645, "o", "\u001b[H\u001b[2J"]
[3.4878, "o", "\u001b[34d\u001b[?25l\u001b[97m\u001b[40mFor information about GNU Emacs and the GNU system, type \u001b[39;49m\u001b[1m\u001b[38;5;39m\u001b[40mC-h C-a\u001b[0m\u001b[39;49m\u001b[97m\u001b[40m.                                                      \u001b[39;49m\r\u001b[H\u001b[38;5;246m\u001b[40m#+title:\u001b[39;49m\u001b[97m\u001b[40m \u001b[39;49m\u001b[1m\u001b[38;5;79m\u001b[40mMultihost — remote operations in Emacs \u001b[0m\u001b[39;49m\u001b[97m\u001b[40m                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40mAn inventory, repeatable Org runbooks, and one result per host.                                                         \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40mIn this recording:                                                                                                      \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m  1. Mark two hosts and run a check in parallel.                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m  2. Read one host, all outputs, and grouped results.                                                                   \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m  3. Execute an Org runbook in selection order.                                                                         \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m  4. Inspect an intentional failure: stderr and exit 7.                                                                 \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40mReal Emacs keys. Vertico and Marginalia are enabled.                                                                    \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40mTwo loopback SSH endpoints share one kernel. No CyberArk deployment.                                                    \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                                                                        \u001b[39;49m\r\n\u001b[A\n\u001b[97m\u001b[40m                                                                 "]

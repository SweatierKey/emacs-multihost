[5.3312, "o", "\u001b[34;1H\u001b[?25l\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40mruns                            \u001b[39;49m\u001b[38;5;116m\u001b[40mDisplay run history.                       \u001b[39;49m\u001b[24;3H\u001b[38;5;79m\u001b[40m30  \u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[48;5;24mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[97m\u001b[48;5;24m                                 \u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;116m\u001b[48;5;24mOpen inventory FILE, or ‘multihost-inventory-file’.         \u001b[0m\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40mshow-combined                   \u001b[39;49m\u001b[38;5;116m\u001b[40mShow every host’s output in one buffer.                     \u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40mmark-all                        \u001b[39;49m\u001b[38;5;116m\u001b[40mMark all inventory hosts.                                 \u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40morg-preview                     \u001b[39;49m\u001b[38;5;116m\u001b[40mShow targets and source without connecting or evaluating he…\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40mcancel-run                      \u001b[39;49m\u001b[38;5;116m\u001b[40mCancel queued work and stop local workers of the current ru…\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40morg-execute-foreground          \u001b[39;49m\u001b[38;5;116m\u001b[40mExecute the current block serially with interactive TRAMP a…\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40minventory-mode                  \u001b[39;49m\u001b[38;5;116m\u001b[40mSelect hosts: m/u mark, T/U all/none, x command, C-u x seri…\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40mshow-digest                     \u001b[39;49m\u001b[38;5;116m\u001b[40mGroup hosts with identical status and output.\u001b[39;49m\r\n\u001b[1m\u001b[38;5;39m\u001b[40mmultihost\u001b[0m\u001b[39;49m\u001b[1m\u001b[38;5;212m\u001b[40m-\u001b[0m\u001b[39;49m\u001b[97m\u001b[40morg-completion-disable          \u001b[39;49m\u001b[38;5;116m\u001b[40mStop remote completion and its pending requests in this buf\u001b[39;49m\u001b[24;21H\u001b[?12l\u001b[?25h\u001b[?12;25h"]

(ert-deftest multihost-connection-local-config-validation-performs-no-remote-io ()
  (multihost-connection-test--isolated
    (dolist (setting '(state init program relative-program relative-state))
      (let ((multihost-state-directory multihost-state-directory)
            (multihost-worker-init-file multihost-worker-init-file)
            (multihost-worker-program multihost-worker-program)
            (default-directory default-directory))
        (pcase setting
          ('state (setq multihost-state-directory "/ssh:secret:/state/"))
          ('init (setq multihost-worker-init-file "/ssh:secret:/init.el"))
          ('program (setq multihost-worker-program "/ssh:secret:/emacs"))
          ('relative-program (setq multihost-worker-program "./emacs" default-directory "/ssh:secret:/"))
          ('relative-state (setq multihost-state-directory "state" default-directory "/ssh:secret:/")))
        (cl-letf (((symbol-function 'file-readable-p) (lambda (&rest _) (ert-fail "Configuration caused I/O")))
                  ((symbol-function 'executable-find) (lambda (&rest _) (ert-fail "Configuration caused executable search")))
                  ((symbol-function 'make-directory) (lambda (&rest _) (ert-fail "Configuration caused directory I/O"))))
          (should-error (multihost-connection-submit "/ssh:web:/" 'test nil nil) :type 'user-error))))))

(ert-deftest multihost-connection-identity-keeps-user-hop-port-and-state ()
  (multihost-connection-test--isolated
    (let ((keys (mapcar #'multihost-connection--key
                       '("/ssh:ops@web#2222:/a/" "/ssh:root@web#2222:/a/"
                         "/ssh:ops@web#22:/a/" "/ssh:jump|ssh:ops@web#2222:/a/"))))
      (should (= (length (delete-dups (copy-tree keys))) 4))
      (should (equal (car keys) (multihost-connection--key "/ssh:ops@web#2222:/b/")))
      (let ((multihost-state-directory (expand-file-name "other" multihost-state-directory)))
        (should-not (equal (car keys) (multihost-connection--key "/ssh:ops@web#2222:/a/")))))))

(ert-deftest multihost-connection-payload-snapshot-and-private-files ()
  (multihost-connection-test--isolated
    (let* ((secret (copy-sequence "TOP_SECRET"))
           (request (multihost-connection-submit "/ssh:web:/" 'test (list :value secret) nil)))
      (aset secret 0 ?X)
      (multihost-connection-test--wait request)
      (should (equal (cadr (plist-get (multihost-request-result request) :value)) "TOP_SECRET"))
      (should-not (string-match-p "TOP_SECRET" (prin1-to-string (multihost-connection-snapshots))))
      (let ((storage (multihost-connection-worker-storage (multihost-request-worker request))))
        (should (= (logand (file-modes storage) #o777) #o700))
        (dolist (name '("request.json" "result.json" "bootstrap.json"))
          (should-not (file-exists-p (expand-file-name name storage))))))))

(ert-deftest multihost-connection-observer-can-submit-during-spawn-failure ()
  (multihost-connection-test--isolated
    (let ((program multihost-worker-program) next)
      (let* ((multihost-worker-program "/nonexistent/multihost-emacs")
             (request (multihost-connection-submit
                       "/ssh:web:/" 'test nil
                       (lambda (&rest _)
                         (let ((multihost-worker-program program))
                           (setq next (multihost-connection-submit "/ssh:web:/" 'test nil nil)))))))
        (multihost-connection-test--wait request)
        (should next)
        (multihost-connection-test--wait next)
        (should (eq (multihost-request-status next) 'succeeded))))))

(ert-deftest multihost-connection-wrong-result-schema-is-rejected ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) (callbacks 0)
           (request (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                 (lambda (&rest _) (cl-incf callbacks)))))
      (multihost-connection-test--wait request (lambda (_) (file-exists-p marker)))
      (let ((worker (multihost-request-worker request)))
        (multihost-worker--write-json
         (multihost-connection--request-file worker "result")
         `(("schema" . 42) ("id" . ,(multihost-request-id request))
           ("result" . ,(multihost-worker--encode-value '(:status succeeded)))))
        (multihost-connection--filter
         worker (multihost-request-process request)
         (concat "MULTIHOST-RPC/1 "
                 (json-encode `(("worker" . ,(multihost-connection-worker-id worker))
                                ("kind" . "result") ("id" . ,(multihost-request-id request)))) "\n")))
      (should (eq (multihost-request-status request) 'failed))
      (should (= callbacks 1))
      (should-not (process-live-p (multihost-request-process request))))))

(ert-deftest multihost-connection-cleanup-errors-never-lose-callback-or-worker-slot ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) (callbacks 0)
           (request (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                 (lambda (&rest _) (cl-incf callbacks)))))
      (multihost-connection-test--wait request (lambda (_) (file-exists-p marker)))
      (cl-letf (((symbol-function 'delete-file) (lambda (&rest _) (error "Simulated file cleanup failure")))
                ((symbol-function 'delete-directory) (lambda (&rest _) (error "Simulated directory cleanup failure"))))
        (multihost-connection-cancel request))
      (should (= callbacks 1))
      (should (eq (multihost-request-status request) 'cancelled))
      (should-not (process-live-p (multihost-request-process request)))
      (should-not (multihost-connection-snapshots))
      (let ((next (multihost-connection-submit "/ssh:web:/" 'test nil nil)))
        (multihost-connection-test--wait next)
        (should (eq (multihost-request-status next) 'succeeded))))))


(ert-deftest multihost-connection-crash-does-not-replay-and-queue-recovers ()
  (multihost-connection-test--isolated
    (let* ((first (multihost-connection-submit "/ssh:web:/" 'test '(:crash t) nil))
           (next (multihost-connection-submit "/ssh:web:/" 'test nil nil)))

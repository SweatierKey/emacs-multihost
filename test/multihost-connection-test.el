(require 'ert)
(require 'multihost-connection)

(defmacro multihost-connection-test--isolated (&rest body)
  (declare (indent 0) (debug t))
  `(let* ((multihost-state-directory (make-temp-file "multihost-pool-test-" t))
          (multihost-worker-init-file (expand-file-name "init.el" multihost-state-directory))
          (multihost-connection-limit 2)
          (multihost-connection-idle-timeout 60)
          (multihost-connection--workers nil)
          (multihost-connection--queue nil)
          (multihost-connection--pump-timer nil))
     (with-temp-file multihost-worker-init-file
       (prin1 '(setq multihost-worker-operation-functions
                     '((test . (lambda (payload directory)
                                 (when (plist-get payload :prompt) (read-passwd "Password: "))
                                 (when (plist-get payload :crash) (kill-emacs 23))
                                 (when (plist-get payload :marker)
                                   (with-temp-buffer
                                     (insert "executed\n")
                                     (append-to-file (point-min) (point-max) (plist-get payload :marker))))
                                 (when (plist-get payload :gate)
                                   (while (not (file-exists-p (plist-get payload :gate))) (sleep-for 0.02)))
                                 (when (plist-get payload :fault)
                                   (let* ((request (multihost-worker--read-json "request.json"))
                                          (worker (file-name-nondirectory (directory-file-name default-directory)))
                                          (id (gethash "id" request)))
                                     (pcase (plist-get payload :fault)
                                       ('wrong-worker (multihost-worker--notify "wrong-worker" "result" id))
                                       ('wrong-id (multihost-worker--notify worker "result" "wrong-id"))
                                       ('oversized-line (princ (concat (make-string 70000 ?X) "\n")))
                                       ('malformed (princ "MULTIHOST-RPC/1 {bad json\n")))
                                     nil))
                                 (list :status 'succeeded :value (list directory (plist-get payload :value)))))))
              (current-buffer)))
     (set-file-modes multihost-worker-init-file #o600)
     (unwind-protect (progn ,@body)
       (multihost-connection-reset)
       (when (timerp multihost-connection--pump-timer) (cancel-timer multihost-connection--pump-timer))
       (delete-directory multihost-state-directory t))))

(defun multihost-connection-test--wait (request &optional predicate)
  (let ((deadline (+ (float-time) 10))
        (predicate (or predicate (lambda (request)
                                   (memq (multihost-request-status request) multihost-connection--terminal)))))
    (while (and (not (funcall predicate request)) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should (funcall predicate request))
    request))

(ert-deftest multihost-connection-reuses-worker-and-keeps-cwd-per-request ()
  (multihost-connection-test--isolated
    (let* ((one (multihost-connection-submit "/ssh:ops@web#2222:/first/" 'test '(:value "one") nil))
           (_ (multihost-connection-test--wait one))
           (two (multihost-connection-submit "/ssh:ops@web#2222:/second/" 'test '(:value "two") nil)))
      (multihost-connection-test--wait two)
      (should (eq (multihost-request-status one) 'succeeded))
      (should (eq (multihost-request-status two) 'succeeded))
      (should (eq (multihost-request-process one) (multihost-request-process two)))
      (should (equal (plist-get (multihost-request-result two) :value) '("/ssh:ops@web#2222:/second/" "two")))
      (should (= (plist-get (car (multihost-connection-snapshots)) :completed) 2)))))

(defun multihost-connection-test--touch (file)
  (with-temp-file file (insert "released")))

(ert-deftest multihost-connection-queued-cancel-keeps-active-request-and-calls-once ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) counts
           (active (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                (lambda (_request result) (push (plist-get result :status) counts))))
           (queued (multihost-connection-submit "/ssh:web:/other/" 'test '(:value "cancelled")
                                                (lambda (_request result) (push (plist-get result :status) counts)))))
      (multihost-connection-test--wait active (lambda (_) (file-exists-p marker)))
      (should (eq (multihost-request-status queued) 'queued))
      (multihost-connection-cancel queued)
      (multihost-connection-cancel queued)
      (should (process-live-p (multihost-request-process active)))
      (multihost-connection-test--touch gate)
      (multihost-connection-test--wait active)
      (should (equal (sort counts #'string<) '(cancelled succeeded)))
      (should (= (plist-get (car (multihost-connection-snapshots)) :completed) 1)))))

(ert-deftest multihost-connection-active-cancel-discards-worker-without-replay ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) (callbacks 0)
           (active (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                (lambda (&rest _) (cl-incf callbacks)))))
      (multihost-connection-test--wait active (lambda (_) (file-exists-p marker)))
      (multihost-connection-cancel active)
      (multihost-connection-cancel active)
      (should (= callbacks 1))
      (should-not (process-live-p (multihost-request-process active)))
      (let ((next (multihost-connection-submit "/ssh:web:/" 'test '(:value "next") nil)))
        (multihost-connection-test--wait next)
        (should (eq (multihost-request-status next) 'succeeded))
        (should-not (eq (multihost-request-process active) (multihost-request-process next))))
      (with-temp-buffer (insert-file-contents marker) (should (equal (buffer-string) "executed\n"))))))

(ert-deftest multihost-connection-timeout-includes-queue-without-cancelling-other-work ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory))
           (active (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker) nil))
           (queued (multihost-connection-submit "/ssh:web:/" 'test nil nil :timeout 1)))
      (multihost-connection-test--wait active (lambda (_) (file-exists-p marker)))
      (multihost-connection-test--wait queued)
      (should (eq (multihost-request-status queued) 'timed-out))
      (should-not (multihost-request-process queued))
      (should (process-live-p (multihost-request-process active)))
      (multihost-connection-test--touch gate)
      (multihost-connection-test--wait active)
      (should (eq (multihost-request-status active) 'succeeded)))))

(ert-deftest multihost-connection-active-timeout-retires-worker ()
  (multihost-connection-test--isolated
    ;; Warm up locally so the deadline tests running execution, not CI startup.
    (multihost-connection-test--wait (multihost-connection-submit "/ssh:web:/" 'test nil nil))
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) (callbacks 0)
           (request (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                 (lambda (&rest _) (cl-incf callbacks)) :timeout 1)))
      (multihost-connection-test--wait request (lambda (_) (file-exists-p marker)))
      (multihost-connection-test--wait request)
      (should (eq (multihost-request-status request) 'timed-out))
      (should (= callbacks 1))
      (should-not (process-live-p (multihost-request-process request)))
      (should-not (multihost-connection-snapshots)))))

(ert-deftest multihost-connection-global-limit-and-per-host-order ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (one-marker (expand-file-name "one" multihost-state-directory))
           (two-marker (expand-file-name "two" multihost-state-directory))
           (one (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker one-marker) nil))
           (same-host (multihost-connection-submit "/ssh:web:/second/" 'test nil nil))
           (two (multihost-connection-submit "/ssh:db:/" 'test (list :gate gate :marker two-marker) nil))
           (third (multihost-connection-submit "/ssh:other:/" 'test nil nil)))
      (multihost-connection-test--wait one (lambda (_) (and (file-exists-p one-marker) (file-exists-p two-marker))))
      (should (= (length (multihost-connection-snapshots)) 2))
      (should (eq (multihost-request-status same-host) 'queued))
      (should (eq (multihost-request-status third) 'queued))
      (multihost-connection-test--touch gate)
      (mapc #'multihost-connection-test--wait (list one same-host two third))
      (should (>= (multihost-request-started-at same-host) (multihost-request-ended-at one)))
      (should (cl-every (lambda (request) (eq (multihost-request-status request) 'succeeded))
                        (list one same-host two third)))
      (should (<= (length (multihost-connection-snapshots)) 2)))))

(ert-deftest multihost-connection-idle-eviction-and-ttl ()
  (multihost-connection-test--isolated
    (let* ((multihost-connection-limit 1)
           (first (multihost-connection-submit "/ssh:web:/" 'test nil nil)))
      (multihost-connection-test--wait first)
      (let ((second (multihost-connection-submit "/ssh:db:/" 'test nil nil)))
        (multihost-connection-test--wait second)
        (should (eq (multihost-request-status second) 'succeeded))
        (should-not (process-live-p (multihost-request-process first)))
        (let ((multihost-connection-idle-timeout 0.05)
              (third (multihost-connection-submit "/ssh:db:/" 'test nil nil)))
          (multihost-connection-test--wait third)
          (multihost-connection-test--wait third (lambda (_) (null (multihost-connection-snapshots))))
          (should-not (process-live-p (multihost-request-process second))))))))

(ert-deftest multihost-connection-reset-is-targeted-and-calls-queued-observers ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory)) (count 0)
           (active (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker)
                                                (lambda (&rest _) (cl-incf count))))
           (queued (multihost-connection-submit "/ssh:web:/" 'test nil (lambda (&rest _) (cl-incf count))))
           (other (multihost-connection-submit "/ssh:db:/" 'test nil nil)))
      (multihost-connection-test--wait active (lambda (_) (file-exists-p marker)))
      (multihost-connection-test--wait other)
      (multihost-connection-reset "/ssh:web:/unrelated-cwd/")
      (should (= count 2))
      (should (eq (multihost-request-status active) 'cancelled))
      (should (eq (multihost-request-status queued) 'cancelled))
      (should (process-live-p (multihost-request-process other)))
      (should (equal (mapcar (lambda (x) (plist-get x :directory)) (multihost-connection-snapshots)) '("/ssh:db:"))))))

(ert-deftest multihost-connection-init-change-invalidates-queued-and-idle-workers ()
  (multihost-connection-test--isolated
    (let* ((gate (expand-file-name "gate" multihost-state-directory))
           (marker (expand-file-name "marker" multihost-state-directory))
           (first (multihost-connection-submit "/ssh:web:/" 'test (list :gate gate :marker marker) nil))
           (queued (multihost-connection-submit "/ssh:web:/" 'test nil nil)))
      (multihost-connection-test--wait first (lambda (_) (file-exists-p marker)))
      (with-temp-buffer (insert "\n;; changed trusted configuration\n")
                        (append-to-file (point-min) (point-max) multihost-worker-init-file))
      (multihost-connection-test--touch gate)
      (multihost-connection-test--wait first)
      (multihost-connection-test--wait queued)
      (should (eq (multihost-request-status queued) 'failed))
      (should (string-match-p "init changed" (plist-get (multihost-request-result queued) :error)))
      (let ((next (multihost-connection-submit "/ssh:web:/" 'test nil nil)))
        (multihost-connection-test--wait next)
        (should (eq (multihost-request-status next) 'succeeded))
        (should-not (eq (multihost-request-process first) (multihost-request-process next)))))))


(ert-deftest multihost-connection-local-configuration-works-from-remote-buffer ()
  (multihost-connection-test--isolated
    (let* ((default-directory "/ssh:unreachable:/remote/")
           (tramp-default-proxies-alist nil)
           (request (multihost-connection-submit "/ssh:first|ssh:user@target:/tmp/" 'test nil nil)))
      ;; The handler is local-only; any real remote I/O in the parent is a bug.

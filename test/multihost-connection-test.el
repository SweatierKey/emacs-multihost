(ert-deftest multihost-connection-protocol-faults-retire-workers-exactly-once ()
  (multihost-connection-test--isolated
    (dolist (fault '(wrong-worker wrong-id malformed oversized-line))
      (let* ((count 0)
             (request (multihost-connection-submit "/ssh:web:/" 'test (list :fault fault)
                                                  (lambda (&rest _) (cl-incf count)))))
        (multihost-connection-test--wait request)
        (should (eq (multihost-request-status request) 'failed))

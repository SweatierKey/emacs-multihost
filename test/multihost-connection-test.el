      (should (eq (multihost-request-status request) 'succeeded))
      (should-not tramp-default-proxies-alist))))

(ert-deftest multihost-connection-child-prefers-source-over-stale-bytecode ()
  (multihost-connection-test--isolated
    (let ((helper (expand-file-name "multihost-test-stale.el" multihost-state-directory)))
      (with-temp-file helper
        (insert ";;; fixture -*- lexical-binding: t; -*-\n"
                "(defconst multihost-test-stale-value \"old\")\n"
                "(provide 'multihost-test-stale)\n"))
      (should (byte-compile-file helper))
      (with-temp-file helper
        (insert ";;; fixture -*- lexical-binding: t; -*-\n"
                "(defconst multihost-test-stale-value \"new\")\n"
                "(provide 'multihost-test-stale)\n"))
      ;; Make the source newer even on file systems with coarse timestamps.
      (set-file-times helper (time-add (current-time) 5))
      (with-temp-buffer
        (insert "\n")
        (prin1 `(progn
                  (add-to-list 'load-path ,multihost-state-directory)
                  (require 'multihost-test-stale)
                  (setq multihost-worker-operation-functions
                        '((test . (lambda (_payload _directory)
                                    (list :status 'succeeded :value multihost-test-stale-value))))))
               (current-buffer))
        (append-to-file (point-min) (point-max) multihost-worker-init-file))
      (let ((request (multihost-connection-submit "/ssh:web:/" 'test nil nil)))
        (multihost-connection-test--wait request)
        (should (eq (multihost-request-status request) 'succeeded))
        (should (equal (plist-get (multihost-request-result request) :value) "new"))))))

